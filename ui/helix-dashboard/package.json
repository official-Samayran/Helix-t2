{
    "name": "helix-dashboard",
    "private": true,
    "version": "0.0.0",
    "type": "module",

    "main": "electron/main.cjs",

    "scripts": {
        "dev": "vite --host 127.0.0.1",

        "electron": "wait-on http://127.0.0.1:5173 && electron electron/main.cjs",

        "start": "concurrently \"npm run dev\" \"npm run electron\"",

        "build": "vite build"
    },

    "dependencies": {
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },

    "devDependencies": {
        "@vitejs/plugin-react": "^4.3.1",
        "concurrently": "^9.0.1",
        "electron": "^31.4.0",
        "vite": "^5.4.8",
        "wait-on": "^8.0.1"
    }
}